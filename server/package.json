{
  "name": "islam-shahat-portfolio-backend",
  "version": "2.0.0",
  "description": "Full-Stack Portfolio Backend with Node.js Express, MongoDB, and Admin Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "nodemonConfig": {
    "ext": "js,json,env",
    "ignore": [
      "uploads/*",
      "logs/*"
    ]
  },
  "keywords": [
    "portfolio",
    "full-stack",
    "express",
    "mongodb",
    "dashboard"
  ],
  "author": "Islam Shahat",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sharp": "^0.35.4"
  }
}
