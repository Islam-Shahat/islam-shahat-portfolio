# ============================================
# SERVER CONFIGURATION (إعدادات الخادم)
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION (قاعدة البيانات)
# ============================================
# MongoDB Atlas URI (Cloud) or Local URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/eslam_portfolio?retryWrites=true&w=majority

# ============================================
# SECURITY & AUTHENTICATION (الأمان والمصادقة)
# ============================================
# Required for signing JWT tokens (Must be a long random string - Mandatory)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Admin Dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Whitelist allowed origins for CORS (comma-separated, or * for open during dev)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500,https://your-portfolio-domain.vercel.app

# ============================================
# CLOUDINARY — رفع الصور والملفات على السحابة
# احصل على المفاتيح من: https://console.cloudinary.com
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ============================================
# EMAIL / SMTP (اختياري — في حال تفعيل التنبيهات بالبريد)
# ============================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_specific_password
